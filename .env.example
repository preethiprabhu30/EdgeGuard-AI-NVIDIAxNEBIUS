# Runtime
EDGEGUARD_MODE=mock
EDGEGUARD_CAMERA_INDEX=0
EDGEGUARD_SAMPLE_INTERVAL_SEC=2
EDGEGUARD_HAZARD_THRESHOLD=0.60
EDGEGUARD_API_HOST=0.0.0.0
EDGEGUARD_API_PORT=8000

# Provider: mock | nvidia | nebius
EDGEGUARD_PROVIDER=mock

# NVIDIA NIM
NVIDIA_BASE_URL=http://localhost:8001/v1
NVIDIA_API_KEY=not-used
NVIDIA_MODEL=zai-org/GLM-5.3-Flash

# Nebius Serverless Endpoint / OpenAI-compatible endpoint
NEBIUS_BASE_URL=https://YOUR-ENDPOINT/v1
NEBIUS_API_KEY=
NEBIUS_MODEL=YOUR_MODEL_NAME

# Optional webhook for alerts
EDGEGUARD_ALERT_WEBHOOK=
